# Identificação do projeto
# Nome exibido no título das páginas, no cabeçalho e no rodapé
APP_NOME=Projeto Base
# Nome do projeto Compose (prefixo de containers, volumes e rede) e da imagem Docker.
# Troque em cada projeto derivado para não colidir com outros na mesma máquina.
COMPOSE_PROJECT_NAME=projeto_base
APP_IMAGE=projeto-base

# Portas publicadas no host (mude se outro projeto já usar a mesma)
APP_PORT=8001
DB_PORT=5433
REDIS_PORT=6379
FLOWER_PORT=5555

# Django
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django-web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# PostgreSQL principal
POSTGRES_DB=projeto_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=

# Celery e Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Flower
FLOWER_USER=admin
FLOWER_PASSWORD=troque-esta-senha
